{
  "expo": {
    "name": "Gayıt",
    "slug": "gayit-app",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "scheme": "gayit",
    "plugins": [
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-asset",
      
    ],
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F0"
    },
    "updates": {
      "url": "https://u.expo.dev/bedf51a1-744f-4b74-a9ac-1c5dfc366127",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "bedf51a1-744f-4b74-a9ac-1c5dfc366127"
      }
    },
    "android": {
      "package": "com.gayit.android",
      "targetSdkVersion": 35,
      "versionCode": 30,
      "newArchEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#F5F5F0"
      },
      "androidNavigationBar": {
        "visible": "leanback"
      }
    },
    "ios": {
      "newArchEnabled": false
    },
    "web": {
      "favicon": "./icon.png",
      "pwa": {
        "enabled": true,
        "icon": "./icon.png",
        "themeColor": "#F5F5F0"
      }
    }
  }
}
